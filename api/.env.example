# -----------------------------------------------------------------------
# MergeMind API Server — copy to .env and fill in real values
# -----------------------------------------------------------------------

# Server
PORT=3000
APP_URL=https://api.mergemind.dev

# Public site origin — checkout success/cancel redirects land here (never the API host)
SITE_URL=https://mergemind.dev

# Path to the JSON key store (defaults to api/data/keys.json)
KEYS_DB_PATH=/data/keys.json

# Admin secret — used to authenticate key creation and revocation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change_me_to_a_long_random_string

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PRICE_LICENSE=price_1TRfl1FnIuEgeFxOKGsbD1Ph
PRICE_TEAM_MONTHLY=price_...

# CORS origin of your frontend (if applicable)
# APP_URL=https://mergemind.dev

# License delivery email via Resend (same API key used across CGT products)
# Required for buyers to actually receive their key after checkout.
# EMAIL_FROM domain must be verified in Resend (cyberglobal.ai is; mergemind.dev may not be).
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@cyberglobal.ai

# CGT analytics (Supabase events insert)
SUPABASE_ANON_KEY=sb_publishable_...
