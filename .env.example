# -----------------------------------------------------------------------
# MergeMind GitHub Action — secrets you set in your repo's GitHub settings
# Settings → Secrets and variables → Actions → New repository secret
# -----------------------------------------------------------------------

# Your OpenAI API key (required)
OPENAI_API_KEY=sk-...

# Your MergeMind Pro/Team license key (optional — omit to use free tier)
MERGEMIND_LICENSE_KEY=mm_live_...

# Override the validation URL if you self-host the MergeMind API (optional)
# MERGEMIND_VALIDATION_URL=https://api.mergemind.dev/api/validate-key
